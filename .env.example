# ─────────────────────────────────────────────────────────────────────
#  Kaia — backend configuration
#
#  Copy to backend/.env and fill in the REQUIRED block. Everything below
#  that is optional: leave it blank and the matching feature switches
#  itself off. The app starts and chat works with four values.
#
#  Check your setup at any time:  python scripts/check_env.py
# ─────────────────────────────────────────────────────────────────────


# ═══ REQUIRED ═══ nothing runs without these ═════════════════════════

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# platform.openai.com → API keys
OPENAI_API_KEY=

# Encrypts stored OAuth tokens. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=


# ═══ OPTIONAL ═══ each unlocks one feature ═══════════════════════════

# ── Voice (browser + phone). Without it, text chat still works.
# console.deepgram.com
DEEPGRAM_API_KEY=

# ── Calendar, Gmail, Sheets, Docs.
# console.cloud.google.com → APIs & Services → Credentials → OAuth client
# Add this exact redirect URI to that client, or sign-in fails:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Phone calls. console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The only number Kaia may ever ring. E.164, e.g. +353871234567
OWNER_PHONE_E164=

# ── Weather and maps. console.cloud.google.com
GOOGLE_MAPS_API_KEY=

# ── Spreadsheet CRM and the long-term memory doc (both Google file ids)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_MEMORY_DOC_ID=

# ── Guest portal: where "message Tanishq" is delivered
GUEST_RELAY_TO=


# ═══ DEFAULTS ═══ fine as they are ═══════════════════════════════════

OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_STANDARD=gpt-6-sol
OPENAI_MODEL_PREMIUM=gpt-6.1-terra

APP_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Seconds of silence before Kaia says "one sec" on a call
VOICE_BACKCHANNEL_AFTER_S=5
