# =============================================================================
# Kaia AI Assistant — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI API ---
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STANDARD=gpt-4o
OPENAI_MODEL_PREMIUM=gpt-4.1

# --- Deepgram (STT + TTS) ---
DEEPGRAM_API_KEY=your-deepgram-key

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Google Integration IDs (optional — app creates these if missing) ---
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_MEMORY_DOC_ID=

# --- Telnyx Telephony ---
TELNYX_API_KEY=KEY_your_telnyx_key
TELNYX_PHONE_NUMBER=+353000000000
TELNYX_CONNECTION_ID=your-connection-id
TELNYX_WEBHOOK_SECRET=

# --- Owner Phone (ONLY number assistant can call) ---
OWNER_PHONE_E164=+353851234567

# --- Application ---
APP_BASE_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
TOKEN_ENCRYPTION_KEY=generate-with-fernet
JWT_SECRET=change-this-to-a-random-string

# --- Weather ---
OPENWEATHER_API_KEY=your-openweather-key

# --- Cost Limits ---
MONTHLY_SPEND_LIMIT_USD=50.00
MAX_TOOL_CALLS_PER_TURN=15
MAX_AUDIO_SESSION_SECONDS=600
MAX_CALL_DURATION_SECONDS=300
DAILY_OUTBOUND_CALL_LIMIT=5
